{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-20250514",
  "small_model": "anthropic/claude-haiku-4-5",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny"
    },
    "edit": "allow",
    "write": "allow",
    "bash": {
      "*": "allow",
      "rm -rf /": "deny",
      "rm -rf ~": "deny",
      "sudo *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "/tmp/agent-called-what/**": "allow"
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "data/**/*.json",
      "*.log"
    ]
  }
}
